<main class="main-contenedor">
  <section class="login">
    <h1>Iniciar Sesión</h1>

    <% if (typeof mensaje !== 'undefined' && mensaje) { %>
    <div
      style="
        background-color: #d1fae5;
        color: #065f46;
        padding: 10px;
        border-radius: 8px;
        margin-bottom: 20px;
        text-align: center;
      "
    >
      <%= mensaje %>
    </div>
    <% } %> <% if (typeof errores !== 'undefined' && errores.length) { %>
    <div class="errores">
      <ul>
        <% errores.forEach(e => { %>
        <li><%= e %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <form action="/login" method="POST">
      <label for="email">Correo electrónico</label>
      <input
        type="email"
        name="email"
        id="email"
        required
        placeholder="tu@email.com"
      />

      <label for="password">Contraseña</label>
      <input
        type="password"
        name="password"
        id="password"
        required
        placeholder="********"
      />

      <button type="submit">Entrar</button>
    </form>

    <p style="text-align: center; margin-top: 20px">
      ¿No tienes cuenta?
      <a href="/registro" style="color: #a29bfe">Regístrate aquí</a>
    </p>
  </section>
</main>
